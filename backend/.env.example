# Copia este archivo como .env y pon tus datos reales de Supabase
# (Supabase > Project Settings > Database > Connection string > Session pooler)
DATABASE_URL=postgresql+psycopg2://postgres.TU_PROYECTO_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Opcional: webhook de Slack para avisar cuando se crea un producto
SLACK_WEBHOOK_URL=
